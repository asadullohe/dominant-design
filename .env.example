# Telegram bot that receives leads from the contact form (see README → "Telegram bot").
# Keep real values only in Netlify → Site configuration → Environment variables, never in git.
TELEGRAM_BOT_TOKEN=
# Chat(s) that receive leads: a personal chat id or a group id like -100…; separate several with commas.
TELEGRAM_CHAT_ID=

# Public origin for canonical URLs, sitemap and Open Graph. Netlify's URL is used when empty.
SITE_URL=
